# .env.example
# PUBLIC SUPABASE CONFIG (Aman untuk Client/Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# PRIVATE SUPABASE CONFIG (Hanya Server/Route Handlers - Jangan dibocorkan!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# IOT API SECURITY
IOT_DEVICE_SECRET_TOKEN=your-unique-esp32-auth-token

# APP URL
NEXT_PUBLIC_APP_URL=https://hydro.web.id